# TrackIt Environment Configuration Template
# Copy this file to .env for local overrides (never commit .env to GitHub)

PORT=3000

# Your Google Gemini API Key from https://aistudio.google.com/
GEMINI_API_KEY=

# Personal Webhook Secret Token for Apple Health iOS Shortcut
# (If left blank, a secure random token is automatically generated in your local database)
WEBHOOK_TOKEN=
